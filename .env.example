# Configuration de l'environnement Docker pour WordPress
# Copiez ce fichier vers .env et modifiez les valeurs selon vos besoins

# ============================================
# Base de données MariaDB
# ============================================
DB_NAME=wordpress
DB_USER=wordpress
DB_PASSWORD=wordpress
DB_ROOT_PASSWORD=rootpassword
DB_HOST=db
DB_PORT=3306

# ============================================
# Ports des services
# ============================================
# Port pour accéder à WordPress via Nginx
NGINX_PORT=8080

# Port pour accéder directement à MariaDB (optionnel)
# DB_PORT=3306

# Port pour accéder à PhpMyAdmin
PHPMYADMIN_PORT=8081

# ============================================
# Notes importantes
# ============================================
# - Ne commitez JAMAIS le fichier .env dans Git (il contient des mots de passe)
# - Modifiez les mots de passe par défaut en production
# - Les valeurs ci-dessus sont des exemples, adaptez-les à vos besoins
